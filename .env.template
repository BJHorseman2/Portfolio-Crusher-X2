# Portfolio Crusher X2 - Environment Configuration
# Copy this file to .env and fill in your API keys

# REQUIRED: Anthropic Claude API Key
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPTIONAL: Enhanced data sources (not required for MVP)
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# FINANCIAL_MODELING_PREP_API_KEY=your_fmp_key_here

# Application Settings
LOG_LEVEL=INFO
DEBUG_MODE=False

# Security Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,pdf
